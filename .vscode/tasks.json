{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "めいな: GitHubから最新取得",
      "type": "shell",
      "command": "git",
      "args": ["pull", "--ff-only"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "めいな: 開発チェック",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\meina_dev_check.ps1"],
      "options": {"cwd": "${workspaceFolder}", "env": {"MEINA_PYTHON": "C:\\Users\\taiii\\OneDrive\\Desktop\\meina\\.venv\\Scripts\\python.exe"}},
      "problemMatcher": []
    },
    {
      "label": "めいな: 同期してチェック",
      "dependsOn": ["めいな: GitHubから最新取得", "めいな: 開発チェック"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "めいな: アプリ起動",
      "type": "shell",
      "command": "C:\\Users\\taiii\\OneDrive\\Desktop\\meina\\.venv\\Scripts\\python.exe",
      "args": ["meina_app.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}